# A secret key from https://api.astroway.info/dashboard/sign-up
# aw_test_* spends no credits and is the right one while you build.
ASTROWAY_API_KEY=aw_test_your_key_here

# Optional. Defaults to https://api.astroway.info/v1
# ASTROWAY_BASE_URL=https://api.astroway.info/v1

# Optional. The port the server listens on. Defaults to 5178.
# PORT=5178

# Optional. Set when the app is served under a subpath, and build with the
# matching --base, for example:
#   BASE_PATH=/demo/bazi npm start
#   npx vite build --base=/demo/bazi/
# BASE_PATH=/
